@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Shared

<PageTitle>House Price Prediction</PageTitle>

<h1>House Price Prediction</h1>

<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label">Lot Size</label>
        <select class="form-select" @bind="lotArea">
            <option value="5000">Small</option>
            <option value="8500">Medium</option>
            <option value="12000">Large</option>
            <option value="20000">Extra Large</option>
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Overall Quality</label>
        <select class="form-select" @bind="overallQual">
            <option value="3">Poor</option>
            <option value="5">Average</option>
            <option value="7">Good</option>
            <option value="9">Excellent</option>
            <option value="10">Very Excellent</option>
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Overall Condition</label>
        <select class="form-select" @bind="overallCond">
            <option value="3">Poor</option>
            <option value="5">Average</option>
            <option value="7">Good</option>
            <option value="9">Excellent</option>
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Year Built</label>
        <input type="date" class="form-control" @bind="yearBuiltDate" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Bedrooms</label>
        <select class="form-select" @bind="bedroomAbvGr">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Kitchen Quality</label>
        <select class="form-select" @bind="kitchenQual">
            <option value="Ex">Excellent</option>
            <option value="Gd">Good</option>
            <option value="TA">Typical/Average</option>
            <option value="Fa">Fair</option>
        </select>
    </div>
</div>

<button class="btn btn-primary" @onclick="HandleSubmit">Get Prediction</button>

@if (predictedPrice != "")
{
    <p class="mt-3 fs-5">Predicted price: @predictedPrice</p>
}

@code {
    private int msSubClass = 60; // 2-story, 1946+ - a common, typical dwelling type
    private string msZoning = "RL"; // Residential Low density - most common zoning
    private int lotArea;
    private string lotShape = "";
    private string neighborhood = "CollgCr"; // a solid, mid-range neighborhood
    private int overallQual;
    private int overallCond;
    private DateTime yearBuiltDate = new DateTime(2000, 1, 1);
    private int bedroomAbvGr;
    private string kitchenQual = "";

    private string predictedPrice = "";

    public class PredictionResponse
    {
        public double predicted_price { get; set; }
    }

    private async Task HandleSubmit()
    {

        HouseFeatures dataToSend = new HouseFeatures
        {
            MSSubClass = msSubClass,
            MSZoning = msZoning,
            LotArea = lotArea,
            LotShape = lotShape,
            Neighborhood = neighborhood,
            OverallQual = overallQual,
            OverallCond = overallCond,
            YearBuilt = yearBuiltDate.Year,
            BedroomAbvGr = bedroomAbvGr,
            KitchenQual = kitchenQual
        };

        using var httpClient = new HttpClient();
        var response = await httpClient.PostAsJsonAsync("http://localhost:5205/predict", dataToSend);
        var predictionResult = await response.Content.ReadFromJsonAsync<PredictionResponse>();
        predictedPrice = predictionResult?.predicted_price.ToString("C", new System.Globalization.CultureInfo("en-GB")) ??
        "Error";
    }
}
